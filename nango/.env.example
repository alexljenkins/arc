# Generate with: openssl rand -base64 32
NANGO_ENCRYPTION_KEY=

NANGO_DB_USER=nango
NANGO_DB_PASSWORD=nango
NANGO_DB_NAME=nango

SERVER_PORT=3003

# Dashboard login: basic auth using the two vars below.
# Set FLAG_AUTH_ENABLED=true instead for real email/password accounts (sign up via the dashboard UI;
# NANGO_DASHBOARD_USERNAME/PASSWORD are then ignored).
FLAG_AUTH_ENABLED=false
NANGO_DASHBOARD_USERNAME=admin
NANGO_DASHBOARD_PASSWORD=

# Set to your real host when not running locally
NANGO_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_CONNECT_URL=http://localhost:3009
